# ── Salesforce (JWT Bearer) ──────────────────────────────────────────────────
# The Consumer Key shown in Setup → Apps → App Manager → Astrum Lead Agent Worker → View
SF_CLIENT_ID=3MVG9...your_consumer_key_here

# The username of the dedicated integration user you created in Setup
SF_USERNAME=leadagent@astrumcro.com.astrumpar

# The RSA private key base64-encoded (avoids multiline env var issues in Railway).
# Generate with: node -e "const fs=require('fs'); console.log(Buffer.from(fs.readFileSync('keygen/worker.key','utf8')).toString('base64'));"
SF_PRIVATE_KEY_B64=LS0tLS1CRUdJTiBQUkl...

# Sandbox login URL — do NOT change to production
SF_LOGIN_URL=https://test.salesforce.com

# Astrum Target Biotech RecordType Id (from par_sandbox_baseline.md)
SF_ACCOUNT_RECORD_TYPE_ID=012UD000004JErNYAW

# ── Worker tuning ────────────────────────────────────────────────────────────
# How many days back to look for new signals on startup / first run
LOOKBACK_DAYS=7

# Override cron schedules (cron syntax, UTC)
# REGULATORY_CRON=0 * * * *    # hourly (default)
# PRESS_CRON=0 */6 * * *       # every 6 hours (default)
